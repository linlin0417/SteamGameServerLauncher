{
    "id": "icarus",
    "displayName": "Icarus Dedicated Server",
    "sourceType": "steamcmd",
    "steamAppId": "2089300",
    "exeRelativePath": "Icarus/Binaries/Win64/IcarusServer-Win64-Shipping.exe",
    "launchArgsTemplate": "-SteamServerName=\"{serverName}\" -Port={port} -QueryPort={queryPort} {additionalArgs}",
    "isJavaApp": false,
    "configFormat": "ini",
    "configFilePath": "Icarus/Saved/Config/WindowsServer/ServerSettings.ini",
    "configSection": "[/Script/Icarus.DedicatedServerSettings]",
    "configMappings": {
        "SessionName": "{serverName}",
        "JoinPassword": "{password}",
        "AdminPassword": "{adminPassword}",
        "MaxPlayers": "{maxPlayers}",
        "LoadProspect": "{loadProspect}",
        "CreateProspect": "{createProspect}",
        "ResumeProspect": "{resumeProspect}",
        "LastProspectName": "{lastProspectName}",
        "AllowNonAdminsToLaunchProspects": "{allowNonAdminsToLaunch}",
        "AllowNonAdminsToDeleteProspects": "{allowNonAdminsToDelete}",
        "ShutdownIfNotJoinedFor": "{shutdownIfNotJoinedFor}",
        "ShutdownIfEmptyFor": "{shutdownIfEmptyFor}",
        "GameSaveFrequency": "{gameSaveFrequency}",
        "SaveGameOnExit": "{saveGameOnExit}",
        "FiberFoliageRespawn": "{fiberFoliageRespawn}",
        "LargeStonesRespawn": "{largeStonesRespawn}",
        "UseNetworkNAT": "{useNetworkNAT}",
        "AllowP2P": "{allowP2P}",
        "HeartbeatInterval": "{heartbeatInterval}",
        "IdleDisconnectTime": "{idleDisconnectTime}",
        "EnableLogging": "{enableLogging}"
    },
    "configDefaultContent": [
        "[/Script/Icarus.DedicatedServerSettings]",
        "SessionName=",
        "JoinPassword=",
        "AdminPassword=12345678",
        "MaxPlayers=8",
        "LoadProspect=",
        "CreateProspect=",
        "ResumeProspect=False",
        "LastProspectName=",
        "AllowNonAdminsToLaunchProspects=True",
        "AllowNonAdminsToDeleteProspects=False",
        "ShutdownIfNotJoinedFor=0.000000",
        "ShutdownIfEmptyFor=0.000000",
        "GameSaveFrequency=10.0",
        "SaveGameOnExit=True",
        "FiberFoliageRespawn=True",
        "LargeStonesRespawn=True",
        "UseNetworkNAT=True",
        "AllowP2P=True",
        "HeartbeatInterval=30",
        "IdleDisconnectTime=0",
        "EnableLogging=True"
    ],
    "savesRelativePath": "Icarus/Saved/PlayerData/DedicatedServer/Prospects",
    "saveFilePatterns": ["*.json", "*.json.backup"],
    "defaultPort": 17777,
    "defaultQueryPort": 27015,
    "defaultMaxPlayers": 8,
    "extraDefaults": {
        "serverName": "My Icarus Server",
        "password": "",
        "adminPassword": "12345678",
        "maxPlayers": 8,
        "loadProspect": "",
        "createProspect": "",
        "resumeProspect": "False",
        "lastProspectName": "",
        "allowNonAdminsToLaunch": "True",
        "allowNonAdminsToDelete": "False",
        "shutdownIfNotJoinedFor": "0.000000",
        "shutdownIfEmptyFor": "0.000000",
        "gameSaveFrequency": "10.0",
        "saveGameOnExit": "True",
        "fiberFoliageRespawn": "True",
        "largeStonesRespawn": "True",
        "useNetworkNAT": "True",
        "allowP2P": "True",
        "heartbeatInterval": 30,
        "idleDisconnectTime": 0,
        "enableLogging": "True"
    }
}
